# Copy to `.env` next to docker-compose.prod.yml and edit as needed.
# `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Every value below has a working default, so the stack starts with no edits at all.

# ---- Image version (local tag; no registry) ----
# Bump per build if you want to be able to roll back to an older image.
TAG=latest

# ---- Public URL Meteor serves under (MUST be the real externally-reachable URL) ----
# If you expose the app behind a domain or reverse proxy, set that URL here instead.
ROOT_URL=http://localhost:18000

# ---- Host ports ----
APP_PORT=18000
# OLLAMA_PORT=18020   # only used with `--profile gpu`
# MONGO_PORT=18040    # only if you uncomment the mongo `ports:` section

# ---- First administrator ----
# Created on first boot against an empty database. Leave ADMIN_PASSWORD empty and a
# random password is generated and printed once to the app log:
#   docker compose -f docker-compose.prod.yml logs app | grep '\[accounts\]'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Persistent data (relative paths are resolved next to this file) ----
# MongoDB data directory. Point this somewhere else to switch datasets.
CPA_DB_PATH=./data/db

# Uploaded expression files, R scratch space and reference data (.data).
# Must be owned by UID/GID 1000:1000 — see the seeding note in docker-compose.prod.yml.
CPA_DATA_PATH=./data/app-data

# Optional pre-built tutorial site served at /tutorial. An empty directory is fine.
TUTORIAL_DIR=./data/tutorial

# ---- Optional: NCBI / PubMed API key ----
# Purely a rate-limit raiser (3 -> 10 requests/second). Leave unset if you do not have one.
# NCBI_API_KEY=

# ---- Optional: outbound email via Zoho (session-recovery mails) ----
# Leave unset to disable. ZOHO_REDIRECT_URI must match the redirect URI registered
# with your own Zoho OAuth application.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=https://your-domain.example/callback
# ZOHO_FROM_ADDRESS=no-reply@your-domain.example

# ---- Optional: local LLM backend (`--profile gpu`, needs an NVIDIA GPU) ----
# OLLAMA_BIN_DIR must contain an existing Ollama installation; the image does not
# install Ollama itself.
# OLLAMA_MODELS=./data/ollama-models
# OLLAMA_BIN_DIR=./data/ollama-bin
# OLLAMA_MODELS_LIST=mistral-nemo:12b
# OLLAMA_TEST_MODEL=mistral-nemo:12b-65k
